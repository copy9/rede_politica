{
  "expo": {
    "name": "Splitter",
    "slug": "rede-politica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "redepolitica",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redepolitica.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O Splitter usa a câmera para você entrar ao vivo nas batalhas e gravar publicações.",
        "NSMicrophoneUsageDescription": "O Splitter usa o microfone para o áudio das batalhas ao vivo e dos vídeos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030410",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.redepolitica.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 288,
          "backgroundColor": "#030410"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "O Splitter usa a câmera para você entrar ao vivo nas batalhas e gravar publicações.",
          "microphonePermission": "O Splitter usa o microfone para o áudio das batalhas ao vivo e dos vídeos.",
          "recordAudioAndroid": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class livekit.org.webrtc.** { *; }\n-keep class livekit.org.jni_zero.** { *; }\n-dontwarn livekit.org.jni_zero.**\n-keep class io.livekit.** { *; }\n-keep class com.oney.WebRTCModule.** { *; }\n-dontwarn livekit.org.webrtc.**"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter_400Regular.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
